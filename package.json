{
  "name": "modfinity",
  "private": true,
  "description": "Europa Universalis V mods and their tooling",
  "license": "MIT",
  "author": "Gregoire Chevalier",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "tools/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "lint:mods": "npm run build -w pdx-lint && node tools/pdx-lint/dist/cli.js mods",
    "verify": "npm run lint && npm run typecheck && npm test && npm run lint:mods"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
