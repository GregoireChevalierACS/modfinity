# Promptitude panel: ask Claude a question and read the answer, inside the game.
#
# Sending runs the console command "promptitude <text>". The command does not exist,
# but the game writes "Running console command: promptitude <text>" to debug.log,
# where the companion reads it.
#
# The answer is shown here, from localization keys rewritten by the companion. Reloading
# localization is cheap, whereas reloading script floods debug.log (about 9 MB per reload).

widget = {
	name = "promptitude_panel"
	# Scripted widgets need a function for 'visible': this one always returns true.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	# Glued to the bottom left corner of the screen, whatever the resolution.
	parentanchor = bottom|left
	widgetanchor = bottom|left
	position = { 8 -8 }
	size = { 440 520 }
	# Empty parts of the panel let mouse clicks through to the map.
	alwaystransparent = yes

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 6
		alwaystransparent = yes

		# Pushes the content to the bottom of the panel.
		expand = {}

		vbox = {
			name = "promptitude_answer"
			visible = "[GetVariableSystem.Exists('promptitude_open')]"
			layoutpolicy_horizontal = expanding
			margin = { 10 8 }
			spacing = 4
			using = message_text_box_background

			text_multi = {
				maximumsize = { 420 -1 }
				minimumsize = { 420 -1 }
				autoresize = yes
				align = left|nobaseline
				default_format = "#subtle_name"
				text = "PROMPTITUDE_LAST_QUESTION"
			}

			text_multi = {
				maximumsize = { 420 -1 }
				minimumsize = { 420 -1 }
				autoresize = yes
				align = left|nobaseline
				text = "PROMPTITUDE_LAST_ANSWER"
			}
		}

		hbox = {
			name = "promptitude_input_row"
			visible = "[GetVariableSystem.Exists('promptitude_open')]"
			layoutpolicy_horizontal = expanding
			spacing = 6

			# debug.log is written in chunks: while the game is paused, the prompt would stay in memory.
			# Harmless unknown commands (promptitude_flush) fill the chunk so that the prompt reaches the file.
			# They live in localization keys, to keep the GUI lines short.
			#
			# On this editbox, only the first onreturnpressed action runs (tested in game, 1.4.3): Enter sends
			# the prompt and the flush commands in a single ExecuteConsoleCommandsForced. That command splits
			# on ";", so a ";" in a prompt cuts it there. The Send button has no such limit.
			# The panel stays open, so that the answer appears below the question.
			editbox_single = {
				name = "promptitude_editbox"
				size = { 330 30 }
				onreturnpressed = "[ExecuteConsoleCommandsForced(Concatenate(Concatenate('promptitude ', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self)), Localize('PROMPTITUDE_FLUSH_SUFFIX')))]"

				blockoverride "editbox_label" {
					text = "PROMPTITUDE_PLACEHOLDER"
				}
			}

			button_regular = {
				size = { 90 30 }
				text = "PROMPTITUDE_SEND"
				action_tooltip = {
					title = "PROMPTITUDE_SEND"
					on_action = "[ExecuteConsoleCommand(Concatenate('promptitude ', PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('promptitude_editbox'))))]"
					on_action = "[ExecuteConsoleCommandsForced(Localize('PROMPTITUDE_FLUSH_COMMANDS'))]"
					on_action = "[PdxClearEditBoxText(PdxGuiWidget.AccessParent.FindChild('promptitude_editbox'))]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}

		button_regular = {
			size = { 160 30 }
			text = "PROMPTITUDE_TOGGLE"
			tooltip = "PROMPTITUDE_TOGGLE_TOOLTIP"
			onclick = "[GetVariableSystem.Toggle('promptitude_open')]"
		}
	}
}
