# Prototype P4: typing a prompt inside the game.
# Sending runs the console command "promptitude <text>". The command does not exist,
# but the game writes "Running console command: promptitude <text>" to debug.log,
# where the companion reads it. The game state is left untouched.
#
# After sending, the field is cleared and the panel closed (same pattern as the vanilla
# playset creation dialog), so that Enter cannot resend the prompt in a loop.

widget = {
	name = "promptitude_panel"
	# Scripted widgets need a function for 'visible': this one always returns true.
	visible = "[EqualTo_CFixedPoint('(CFixedPoint)0', '(CFixedPoint)0')]"
	# Glued to the bottom left corner of the screen, whatever the resolution.
	parentanchor = bottom|left
	widgetanchor = bottom|left
	position = { 8 -8 }
	size = { 440 72 }
	# Empty parts of the panel let mouse clicks through to the map.
	alwaystransparent = yes

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 6
		alwaystransparent = yes

		hbox = {
			name = "promptitude_input_row"
			visible = "[GetVariableSystem.Exists('promptitude_open')]"
			layoutpolicy_horizontal = expanding
			spacing = 6

			# Several onreturnpressed lines run in order (tested in game, 1.4.3).
			editbox_single = {
				name = "promptitude_editbox"
				size = { 330 30 }
				onreturnpressed = "[ExecuteConsoleCommand(Concatenate('promptitude ', GetTextFromSelfOrAnyChildEditbox(PdxGuiWidget.Self)))]"
				onreturnpressed = "[PdxClearEditBoxText(PdxGuiWidget.Self)]"
				onreturnpressed = "[GetVariableSystem.Clear('promptitude_open')]"

				blockoverride "editbox_label" {
					text = "PROMPTITUDE_PLACEHOLDER"
				}
			}

			button_regular = {
				size = { 90 30 }
				text = "PROMPTITUDE_SEND"
				action_tooltip = {
					title = "PROMPTITUDE_SEND"
					on_action = "[ExecuteConsoleCommand(Concatenate('promptitude ', PdxGuiEditboxGetText(PdxGuiWidget.AccessParent.FindChild('promptitude_editbox'))))]"
					on_action = "[PdxClearEditBoxText(PdxGuiWidget.AccessParent.FindChild('promptitude_editbox'))]"
					on_action = "[GetVariableSystem.Clear('promptitude_open')]"
				}
				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}

		button_regular = {
			size = { 160 30 }
			text = "PROMPTITUDE_TOGGLE"
			tooltip = "PROMPTITUDE_TOGGLE_TOOLTIP"
			onclick = "[GetVariableSystem.Toggle('promptitude_open')]"
		}
	}
}
